{
  "name": "openspace-mcp",
  "version": "0.1.0",
  "description": "MCP server for controlling a locally running OpenSpace instance",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "openspace-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "lint": "eslint src && prettier --check . && markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "openspace-api-js": "^1.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@openspace/shared-configs": "github:OpenSpace/shared-configs#v1.0.0",
    "@types/node": "^26.6.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "markdownlint-cli2": "^0.24.2",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0"
  },
  "prettier": "@openspace/shared-configs/prettier"
}
